# CloudBoard API Environment Configuration
# Copy this file to .env and adjust values for your local setup

# Application environment
# Accepted values: development | production | test
NODE_ENV=development

# HTTP server port
# Must be a positive integer between 1 and 65535
PORT=3000

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://cloudboard:cloudboard_dev_password@localhost:5432/cloudboard_dev?schema=public

# Comma-separated list of allowed frontend origins for CORS
# Example: http://localhost:3001,https://cloudboard.example.com
ALLOWED_ORIGINS=http://localhost:3001

# Secret used to sign JWT access tokens
# Must be at least 32 characters
# In production, use a cryptographically random string from a secret manager
JWT_ACCESS_SECRET=change_me_to_a_random_string_at_least_32_characters_long

# Access token expiry
# Uses zeit/ms format: 15m, 1h, 7d
JWT_ACCESS_EXPIRY=15m

# Refresh token expiry in days
JWT_REFRESH_EXPIRY_DAYS=30